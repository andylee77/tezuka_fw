#!/bin/sh
#
# Generate certificates for p25-httpd on first boot. Stored on the
# persistent JFFS2 partition so they survive across reboots and only
# get regenerated if the JFFS2 volume is wiped. Modeled on the
# S50maia-sdr-certificates script from the Maia overlay.
#

case "$1" in
    start)
        # Ensure JFFS2 is mounted; format the partition on first boot.
        mount | grep mtd2 > /dev/null || (flash_erase -j /dev/mtd2 0 0 && mount /mnt/jffs2)
        if [ -f /mnt/jffs2/p25-sdr-ca.crt ] && \
           [ -f /mnt/jffs2/p25-httpd.crt ] && \
           [ -f /mnt/jffs2/p25-httpd.key ]; then
            # Certs already present — nothing to do.
            exit 0
        fi
        echo -n "Generating p25-httpd certificates: "
        # Derive a per-board identifier from the SPI-NOR unique ID so
        # each board gets a distinct CN. Falls back to a generic string
        # if dmesg doesn't have the line (already rotated off the ring).
        serial=`dmesg | grep SPI-NOR-UniqueID`
        serial=${serial#*SPI-NOR-UniqueID }
        : "${serial:=fishball-p25}"
        # Generate CA certificate and key.
        openssl req -x509 -nodes -days 36500 -newkey rsa:2048 \
                -subj "/O=Fishball P25/OU=P25 CA/CN=p25-httpd CA serial ${serial}" \
                -keyout /tmp/p25-sdr-ca.key -out /mnt/jffs2/p25-sdr-ca.crt \
                -reqexts v3_req -extensions v3_ca
        # Generate p25-httpd server key + CSR.
        openssl req -new -nodes -newkey rsa:2048 \
                -subj "/O=Fishball P25/OU=p25-httpd/CN=p25-httpd tezuka-fw serial ${serial}" \
                -keyout /mnt/jffs2/p25-httpd.key -out /tmp/p25-httpd.csr
        # Sign the server cert against the freshly-minted CA.
        openssl x509 -req -days 36500 \
                -in /tmp/p25-httpd.csr -CA /mnt/jffs2/p25-sdr-ca.crt -CAkey /tmp/p25-sdr-ca.key \
                -extfile /etc/ssl/p25-httpd-extfile \
                -CAcreateserial -CAserial /tmp/p25-sdr-ca.srl -out /mnt/jffs2/p25-httpd.crt
        # Private key material that should never leave tmpfs is removed.
        rm -f /tmp/p25-sdr-ca.key /tmp/p25-httpd.csr /tmp/p25-sdr-ca.srl
        [ $? = 0 ] && echo "OK" || echo "FAIL"
        ;;
    stop)
        ;;
    restart|reload)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
