#!/bin/sh
#
# p25-httpd init script.
#
# Note on stdout/stderr: start-stop-daemon -b detaches the process from the
# controlling terminal and busybox closes its standard streams, so any
# tracing::info!/warn!/error! calls in the binary disappear into /dev/null.
# We work around that by running the binary inside a sh -c that redirects
# stdout+stderr to /var/log/p25-httpd.log.
#
# The previous log is rotated to .prev on each start so a crash leaves a
# diagnostic trail across reboots.
#
# 2026-09-28 (p25-httpd change 071a): the binary runs under a respawn loop.
# p25-httpd exits on any panic (its state is suspect afterwards) and the
# loop restarts it after 3 s; each exit is logged to $LOG. The recorded pid
# is the loop shell: stop sends it TERM and its trap stops p25-httpd.

LOG=/var/log/p25-httpd.log
PIDF=/var/run/p25-httpd.pid

case "$1" in
  start)
	echo -n "Starting p25-httpd: "
        if [ -f /usr/bin/p25-httpd.xz ]; then
            xz -d /usr/bin/p25-httpd.xz
            chmod +x /usr/bin/p25-httpd
        fi
        # The activity history and the recordings live on the SD card,
        # which S91nfs-mount would mount only after this script: mount it
        # now (p25-httpd also waits up to 20 s for it). Repair the FAT
        # first: power cuts and unplugging leave it dirty, and a damaged
        # FAT sends the card read-only mid-write.
        mkdir -p /var/log
        if [ -e /dev/mmcblk0p1 ] && ! grep -q " /mnt/sd " /proc/mounts; then
            mkdir -p /mnt/sd
            if command -v fsck.fat > /dev/null; then
                echo "== $(date) fsck.fat -a" >> /var/log/fsck-sd.log
                fsck.fat -a -w /dev/mmcblk0p1 >> /var/log/fsck-sd.log 2>&1
            fi
            mount /dev/mmcblk0p1 /mnt/sd && echo -n "(SD card mounted) "
        fi
        [ -f "$LOG" ] && mv "$LOG" "${LOG}.prev"
        cd /root
        # Cert paths match the output of S50p25-httpd-certificates.
        # If the cert pair is missing (e.g. JFFS2 was just wiped and
        # S50 hasn't run yet), p25-httpd auto-falls-back to HTTP-only
        # and logs a warning — it does NOT fail to start.
        SSL_ARGS=""
        if [ -f /mnt/jffs2/p25-httpd.crt ] && [ -f /mnt/jffs2/p25-httpd.key ]; then
            SSL_ARGS="--ssl-cert /mnt/jffs2/p25-httpd.crt \
                --ssl-key /mnt/jffs2/p25-httpd.key \
                --listen-https 0.0.0.0:8443"
            if [ -f /mnt/jffs2/p25-sdr-ca.crt ]; then
                SSL_ARGS="$SSL_ARGS --ca-cert /mnt/jffs2/p25-sdr-ca.crt"
            fi
        fi
        # The control channel, LO and preset below are only the fallback:
        # p25-httpd tunes to the active site's plan (change 070).
        start-stop-daemon -S -b -q -m -p "$PIDF" \
            -x /bin/sh -- -c \
            "trap 'kill \$child 2>/dev/null; wait \$child; exit 0' TERM INT
             while :; do
                /usr/bin/p25-httpd \
                    --listen 0.0.0.0:8080 \
                    --rx-lo 858100000 \
                    --preset 8M \
                    --control-freq 860962500 \
                    --lo-ppm 0 \
                    $SSL_ARGS \
                    >> $LOG 2>&1 &
                child=\$!
                wait \$child
                echo \"p25-httpd exited (\$?), restarting in 3 s\" >> $LOG
                sleep 3
             done"
        cd - > /dev/null
	[ $? = 0 ] && echo "OK ($LOG)" || echo "FAIL"
	;;
  stop)
        echo -n "Stopping p25-httpd: "
        start-stop-daemon -K -q -p /var/run/p25-httpd.pid 2>/dev/null
        [ $? = 0 ] && echo "OK" || echo "FAIL"
        # Leave the SD card clean (shutdown runs S91's umount first,
        # while p25-httpd still holds it). start mounts it again.
        for i in 1 2 3 4 5; do pidof p25-httpd > /dev/null || break; sleep 1; done
        grep -q " /mnt/sd " /proc/mounts && sync && umount /mnt/sd 2>/dev/null
	;;
  restart|reload)
        $0 stop
        sleep 1
        $0 start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
